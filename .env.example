# --- API auth ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Optional: hashed password instead of raw password
# ADMIN_PASSWORD_HASH=$2b$12$abcdefghijklmnopqrstuv

# JWT
API_JWT_SECRET=change-this-to-a-long-random-secret
API_JWT_TTL_SECONDS=3600

# --- Optional project configuration ---
MEANINGFUL_DATASET_PATH=

# --- Optional runtime overrides ---
# Example: use a dataset outside the repository
# MEANINGFUL_DATASET_PATH=/path/to/dataset.csv
